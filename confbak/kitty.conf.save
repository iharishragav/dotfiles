# Font
font_family      JetBrains Mono Nerd Font
font_size 11.0


# Padding (why weird value? consistency with foot)
window_margin_width 21.75

# No stupid close confirmation
confirm_os_window_close 0

# Use fish shell
shell fish

map ctrl+0 change_font_size all 0
map ctrl+kp_0 change_font_size all 0

# split behavior:

map ctrl+shift+enter launch --cwd=current
map ctrl+shift+l launch --cwd=current --location=horizontal
map ctrl+shift+k launch --cwd=current --location=vertical
map ctrl+shift+w close_window

map ctrl+alt+t launch --type=tab --cwd=current zsh -c "tmux attach || tmux"


# kitty.conf
enable_audio_bell no
repaint_delay 10
input_delay 1
sync_to_monitor yes
hide_window_decorations yes
start_maximized yes
